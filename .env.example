# Regra do projeto: NENHUM secret é commitado — nem aqui, nem em .env.
# Este arquivo versiona apenas as CHAVES das variáveis de ambiente, sem valores.
# Copie para .env (fora do versionamento) e preencha os valores localmente.

# Claude API — motor de conversa e tools do brain
ANTHROPIC_API_KEY=

# STT (transcrição de áudio do WhatsApp): Groq como principal, OpenAI como fallback
GROQ_API_KEY=
OPENAI_API_KEY=

# Evolution API — sessão WhatsApp (container na mesma VPS)
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
EVOLUTION_WEBHOOK_SECRET=

# Dono único do assistente — todo outro remetente é ignorado
OWNER_WHATSAPP_JID=

# Google OAuth — Calendar (M1) e Gmail readonly (M2), escopos mínimos (ADR-010)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Chave de cifra dos tokens OAuth em repouso no SQLite
TOKEN_ENCRYPTION_KEY=

# Alertas por e-mail (canal fora do WhatsApp) — escolha SMTP_URL ou RESEND_API_KEY
SMTP_URL=
# RESEND_API_KEY=
ALERT_EMAIL=

# Dead man's switch externo — ping a cada 5 min
HEALTHCHECKS_PING_URL=

# Banco local e timezone
DB_PATH=
TZ=

# Litestream — replicação contínua do SQLite para Backblaze B2
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
LITESTREAM_BUCKET=
